# ============================================================
# SatQuery AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=SatQuery AI
APP_VERSION=0.1.0
DEBUG=true

# --- Demo Mode ---
# When true, all analysis uses mock providers. No external API keys required.
DEMO_MODE=true

# --- Security ---
# When false, mock fallback is not allowed even on provider failure.
ALLOW_MOCK_FALLBACK=false
# Increase in production
MAX_UPLOAD_SIZE_MB=50

# --- Database ---
DATABASE_URL=sqlite:///./data/satquery.db

# --- Storage ---
STORAGE_PATH=./data
UPLOAD_DIR=./data/uploads
RESULTS_DIR=./data/results
CACHE_DIR=./data/cache

# --- LLM Provider ---
# Options: mock | openai | anthropic | google | azure_openai
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# --- Vision Provider ---
# Options: mock | openai | anthropic | google | azure_openai
VISION_PROVIDER=mock
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=
VISION_TIMEOUT_SECONDS=60

# --- Confidence Thresholds ---
CONFIDENCE_THRESHOLD_LOW=0.40
CONFIDENCE_THRESHOLD_HIGH=0.75

# Weights must sum to 1.0
CONFIDENCE_WEIGHT_INPUT=0.20
CONFIDENCE_WEIGHT_SPECIALIST=0.40
CONFIDENCE_WEIGHT_EVIDENCE=0.20
CONFIDENCE_WEIGHT_AGREEMENT=0.20

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
